{
    "name": "flambo-program",
    "private": true,
    "version": "0.1.6",
    "description": "The official PhreshOS web browser Program.",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "check": "tsc --noEmit",
        "build": "vite-node --config vite.server.ts source/build.ts",
        "dev": "phresh dev",
        "start": "phresh start",
        "pack": "phresh pack",
        "measure": "vite-node --config vite.server.ts scripts/measure-browser.ts",
        "verify": "node --run check && node --run build && vite-node --config vite.server.ts scripts/verify-browser-sessions.ts && vite-node --config vite.server.ts scripts/verify-build.mjs"
    },
    "author": "Zohayr SLILEH",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PhreshOS/flambo-program.git"
    },
    "bugs": {
        "url": "https://github.com/PhreshOS/flambo-program/issues"
    },
    "homepage": "https://github.com/PhreshOS/flambo-program#readme",
    "keywords": [
        "phreshos",
        "program",
        "browser",
        "flambo"
    ],
    "dependencies": {
        "@phreshos/client": "^0.1.8",
        "@phreshos/core": "^0.1.6",
        "@phreshos/react": "^0.1.4",
        "@phreshos/server": "^0.1.7",
        "playwright": "^1.62.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@phreshos/cli": "^0.1.14",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vite-node": "^6.0.0"
    }
}
