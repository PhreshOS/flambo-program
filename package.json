{
    "name": "flambo-program",
    "private": true,
    "version": "0.1.63",
    "description": "Flambo is a shared browser for people and agents on PhreshOS.",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "check": "tsc --noEmit",
        "build": "vite-node scripts/build.ts",
        "dev": "phresh dev",
        "start": "phresh start",
        "pack": "phresh pack",
        "verify": "node --run check && node --run build && node --run test",
        "test": "vitest run"
    },
    "keywords": [
        "phreshos",
        "program",
        "browser"
    ],
    "dependencies": {
        "@phreshos/client": "^0.1.59",
        "@phreshos/core": "^0.1.72",
        "@phreshos/react": "^0.1.37",
        "@phreshos/react-ui": "^0.1.53",
        "@phreshos/server": "^0.1.62",
        "playwright": "^1.63.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "ws": "^8.18.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@phreshos/cli": "^0.1.82",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.10"
    }
}
